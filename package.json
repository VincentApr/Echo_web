{
  "name": "temp_web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "check:independence": "node scripts/check-web-independence.mjs",
    "test:agent-threads": "node scripts/test-agent-thread-execution.mjs && node scripts/test-agent-thread-display.mjs",
    "test:auth": "node scripts/test-auth-session.mjs",
    "test:composer": "node scripts/test-composer-drafts.mjs",
    "test:sync": "node scripts/test-message-sync.mjs",
    "test": "npm run test:auth && npm run test:composer && npm run test:sync && npm run test:agent-threads",
    "test:e2e": "playwright test",
    "prebuild": "npm run check:independence",
    "build": "tsc -b && vite build",
    "start": "node server.js",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.0.1",
    "@tanstack/react-query": "^5.95.0",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "expo": "^55.0.8",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
